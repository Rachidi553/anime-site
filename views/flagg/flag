<!DOCTYPE html>
<html>
<head>
  <title>flag</title>
  <style>
    .flag {
      width: 200px;
      height: 150px;
      position: relative;
    }

    .flag__stripes {
      width: 100%;
      height: 100%;
      position: absolute;
      top: 0;
      left: 0;
      background-image: linear-gradient(to right, #ff0000, #0000ff);
      background-size: auto 100%;
      background-repeat: no-repeat;
      background-position: center;
    }

    .flag__text {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      color: white;
      font-weight: bold;
      font-size: 24px;
    }
  </style>
  <script>
    function createFlag() {
      const flag = document.createElement('div');
      flag.className = 'flag';

      const stripes = document.createElement('div');
      stripes.className = 'flag__stripes';

      const text = document.createElement('div');
      text.className = 'flag__text';
      text.textContent = 'My Web Page';

      flag.appendChild(stripes);
      flag.appendChild(text);

      return flag;
    }

    function addFlagToPage() {
      const flag = createFlag();
      document.body.appendChild(flag);
    }

    addFlagToPage();
  </script>
</head>
<body>
</body>
</html>