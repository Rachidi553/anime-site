<!-- views/users.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Anime List</title>

</head>
<body>
    <h1>Anime List</h1>
    <ul>
        <% animes.forEach(anime => { %>
            <li><strong><%= anime.name %></strong>: <%= anime.details %></li>
        <% }) %>
    </ul>
</body>
</html>
